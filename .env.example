# ---------------------------------------------------------------------------
# Database (required for the app; the marketing site renders without it)
# ---------------------------------------------------------------------------
# Neon: https://console.neon.tech -> project -> connection string (pooled).
# Any Postgres URL works; Neon hosts get the Neon serverless driver, everything
# else falls back to node-postgres.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
# Or run `pnpm db:local` for an in-process Postgres with no account required:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Storage — optional. Without R2 credentials, uploads go to .data/blobs on disk.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="auto"   # auto | r2 | local
# Paste straight from the R2 dashboard. R2_ACCOUNT_ID / R2_BUCKET are accepted
# as aliases if you prefer those names.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

MAX_UPLOAD_BYTES="26214400"   # 25MB
